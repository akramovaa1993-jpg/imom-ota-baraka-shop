TELEGRAM_BOT_TOKEN=PASTE_NEW_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_CHAT_ID_HERE
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_STRONG_PASSWORD
SESSION_SECRET=CHANGE_TO_LONG_RANDOM_SECRET
# Optional staff accounts:
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
STOCK_USERNAME=
STOCK_PASSWORD=
DATA_DIR=./data
PORT=3000

# Doimiy PostgreSQL baza (Supabase/Render Postgres)
DATABASE_URL=
DATABASE_SSL=true

# Optional mobile checkout SMS OTP. Requires PostgreSQL and SMS gateway worker.
# Store real values only in the server's protected environment, never in source control.
SMS_OTP_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SMS_GATEWAY_TOKEN_SHA256=SET_SHA256_HEX_DIGEST_OF_GATEWAY_TOKEN

# Optional: bot username; if omitted server obtains it with Telegram getMe
TELEGRAM_BOT_USERNAME=
